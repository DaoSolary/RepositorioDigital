# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# Use a chave "anon" JWT (eyJ...) em Project Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Site (obrigatório para emails e OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upload
NEXT_PUBLIC_MAX_PDF_MB=20

# Sessão (obrigatório em produção — mín. 32 caracteres aleatórios)
# SESSION_SECRET=gere_com_openssl_rand_hex_32

# Dev only — se aparecer UNABLE_TO_VERIFY_LEAF_SIGNATURE no Windows
SUPABASE_INSECURE_SSL=1
